---
import portfolio from '../data/portfolio.json';

interface Props {
  project: (typeof portfolio.sections)[number]['projects'][number];
  detail?: boolean;
}

const { project, detail = false } = Astro.props;
const milestone = portfolio.milestones
  .filter((item) => item.projectId === project.id)
  .sort((a, b) => b.date.localeCompare(a.date))[0];
const dateLabel = (date: string) => new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`));
---

{detail ? (
  <article class="project project--detail" id={project.id}>
    <div class="project__head">
      <h3 class="project__title">{project.title}</h3>
      <span class="project__gloss">{project.gloss}</span>
    </div>
    {project.stage && <span class="project__stage">{project.stage}</span>}
    <p class="project__summary">{project.summary}</p>
    <p class="project__para"><strong>Aim.</strong>{' '}{project.aim}</p>
    <p class="project__para"><strong>Approach.</strong>{' '}{project.approach}</p>
    {milestone && (
      <div class="project__milestone">
        <span class="meta">Latest public milestone · <time datetime={milestone.date}>{dateLabel(milestone.date)}</time> · {milestone.kind.toLowerCase()}</span>
        <a class="textlink" href={milestone.href}>{milestone.title}</a>
      </div>
    )}
    {project.href && <a class="textlink" href={project.href}>{project.linkLabel} →</a>}
  </article>
) : (
  <a class="project" href={`/projects#${project.id}`}>
    <span class="project__head">
      <span class="project__title">{project.title}</span>
      <span class="project__gloss">{project.gloss}</span>
    </span>
    <span class="project__summary">{project.summary}</span>
  </a>
)}

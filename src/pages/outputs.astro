---
import Layout from '../layouts/Layout.astro';
import publicationsData from '../data/publications.json';

const papers = publicationsData.items;

const software = [
  {
    title: 'trial-emulation',
    status: 'PyPI package',
    description:
      'A Python package for target trial emulation and causal analysis of observational time-to-event data, ported from the TrialEmulation R package. It supports person-time / nested-trial workflows and marginal structural model analyses for research using routinely collected health data.',
    links: [
      { label: 'PyPI', href: 'https://pypi.org/project/trial-emulation/' },
      { label: 'GitHub', href: 'https://github.com/csainsbury/Trial-Emulation-R2P' },
    ],
    tags: ['target trial emulation', 'causal inference', 'time-to-event data', 'Python'],
  },
  {
    title: 'glucose.ai',
    status: 'Public release',
    description:
      'A living map of how machine-learning and AI methods are applied in diabetes and metabolic research. Papers are collected daily from PubMed, arXiv, bioRxiv, medRxiv, OpenAlex and Semantic Scholar, classified by method and clinical task, and embedded for semantic search, with dashboards of method adoption over time.',
    links: [{ label: 'glucose.ai', href: 'https://glucose.ai' }],
    tags: ['diabetes', 'AI methods', 'bibliometrics', 'semantic search'],
  },
];

const talks = [
  {
    date: 'November 2026',
    title: 'Beyond glucose prediction: where else can AI improve diabetes care?',
    venue: 'Diabetes Technology Network UK (DTN-UK)',
    links: [
      { label: 'Companion article', href: 'https://glucose.ai/dtn/article' },
      { label: 'Slides (PDF)', href: 'https://glucose.ai/dtn/dtn-2026-11-sainsbury-slides.pdf' },
    ],
  },
  {
    date: 'April 2026',
    title: 'AI in diabetes care',
    venue: 'Association of British Clinical Diabetologists (ABCD) webinar',
    links: [],
  },
];
---

<Layout title="Outputs — Chris Sainsbury" description="Papers, preprints, software and talks by Chris Sainsbury on AI, electronic health records and diabetes." currentPath="/outputs">
  <section class="page-head">
    <h2 class="label">Outputs</h2>
    <h1>Papers, software and talks</h1>
    <p class="lead">Recent papers and preprints, drawn from my Google Scholar profile, with software and talks.</p>
    <p class="note">Last refreshed {publicationsData.lastRefreshed} · <a class="textlink" href={publicationsData.sourceUrl} target="_blank" rel="noreferrer">Full Google Scholar profile</a></p>
  </section>

  <div class="two-col">
    <section class="section" aria-labelledby="papers-heading">
      <h2 id="papers-heading" class="label">Papers and preprints</h2>
      <div class="outputs">
        {papers.map((paper) => (
          <div class="output">
            <span class="output__meta">{paper.year}{paper.citedBy && ` · cited by ${paper.citedBy}`}</span>
            <div class="output__body">
              {paper.href ? <a class="output__title" href={paper.href} target="_blank" rel="noreferrer">{paper.title}</a> : <span class="output__title">{paper.title}</span>}
              <span class="output__authors">{paper.authors}</span>
              <span class="output__authors">{paper.venue}</span>
            </div>
          </div>
        ))}
      </div>
    </section>

    <aside class="section" aria-labelledby="software-heading">
      <h2 id="software-heading" class="label">Software</h2>
      {software.map((item) => (
        <article class="software">
          <span class="project__gloss">{item.status}</span>
          <h3>{item.title}</h3>
          <p>{item.description}</p>
          <div class="chips">
            {item.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label} →</a>)}
            {item.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </article>
      ))}
      <h2 id="talks-heading" class="label">Talks</h2>
      <div class="outputs">
        {talks.map((talk) => (
          <div class="output output--stacked">
            <span class="output__meta">{talk.date}</span>
            <div class="output__body">
              <span class="output__title">{talk.title}</span>
              <span class="output__authors">{talk.venue}</span>
              {talk.links.length > 0 && (
                <span class="chips">
                  {talk.links.map((link) => <a href={link.href} target="_blank" rel="noreferrer">{link.label} →</a>)}
                </span>
              )}
            </div>
          </div>
        ))}
      </div>
      <p class="muted">Projects, including NEXUS, PRIMA-HD and the pi / Cog research workflows, are described on the <a class="textlink" href="/projects">Projects</a> page.</p>
    </aside>
  </div>
</Layout>

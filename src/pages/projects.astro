---
import Layout from '../layouts/Layout.astro';
import portfolio from '../data/portfolio.json';
import ProjectCard from '../components/ProjectCard.astro';
---

<Layout title="Projects — Chris Sainsbury" currentPath="/projects">
  <section class="page-header copy">
    <div class="eyebrow">projects</div>
    <h1>Research and software</h1>
    <p class="lead">
      Clinical sequence modelling, scientific discovery and tools for doing research.
      These summaries describe the purpose of the work; public outputs provide the detail.
    </p>
    <p class="muted small">
      Where shown, stages describe public development status—not percentage complete or clinical readiness.
      Milestones are dated public outputs, not a live research log.
    </p>
  </section>

  <div class="stack">
    {portfolio.sections.map((section) => (
      <section class="section" aria-labelledby={`${section.title.toLowerCase().replaceAll(' ', '-')}-heading`}>
        <div class="section-head">
          <div>
            <h2 id={`${section.title.toLowerCase().replaceAll(' ', '-')}-heading`}>{section.title}</h2>
            <p>{section.description}</p>
          </div>
        </div>
        <div class="grid two">
          {section.projects.map((project) => <ProjectCard project={project} detail />)}
        </div>
      </section>
    ))}
  </div>
</Layout>

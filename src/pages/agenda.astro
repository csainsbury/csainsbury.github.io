---
import Layout from '../layouts/Layout.astro';

const thursdayAgenda = [
  {
    time: '09:30–09:45',
    title: 'Welcome, introductions, and objectives',
    notes:
      'Confirm the purpose of the kick-off, who is in the room, and the desired outputs from the day.',
  },
  {
    time: '09:45–10:45',
    title: 'TRANsCEnD-CPRD project overview and alignment',
    notes:
      'Orient everyone to the funded CPRD lane before the protocol discussion: project status, governance boundaries, roles, terminology, immediate analytic questions, and how the work relates to ASCEND, ARTEMIS, ORCA, and NEXUS.',
  },
  {
    time: '10:45–11:30',
    title: 'CPRD protocol discussion — first pass',
    notes:
      'Walk through the circulated protocol at a practical level, now that everyone has the project context. Identify headline clarification points, owners, pre-read needs, and any immediate protocol questions.',
  },
  {
    time: '11:30–11:45',
    title: 'Coffee',
    notes: 'Break.',
    break: true,
  },
  {
    time: '11:45–12:30',
    title: 'CPRD protocol discussion — implications and decisions',
    notes:
      'Continue the protocol discussion with emphasis on what needs deciding before Friday: analysis boundaries, first practical steps, dependencies, and ownership of open questions.',
  },
  {
    time: '12:30–13:00',
    title: 'Immediate execution plan',
    notes:
      'Agree the first post-kick-off work block: owner(s), dataset and protocol dependencies, pre-read or follow-up documents, and next check-in.',
  },
  {
    time: '13:00–13:45',
    title: 'Lunch',
    notes: 'Break.',
    break: true,
  },
  {
    time: '13:45–14:45',
    title: 'Where next? NIHR grant opportunity',
    notes:
      'Detailed discussion of the potential NIHR grant route: possible aim, fit to TRANsCEnD/CPRD, partners, deliverables, deadline or eligibility constraints, and whether this should become an active workstream.',
  },
  {
    time: '14:45–15:20',
    title: 'Where next? Rare phenotype identification / fingerprinting',
    notes:
      'Continue the rare-phenotype identification and fingerprinting discussion: what the scientific claim is, what data or evidence would make it credible, and whether it belongs within TRANsCEnD, adjacent to it, or as a separate follow-on.',
  },
  {
    time: '15:20–15:40',
    title: 'Future connected work: ORCA, NEXUS, and related AI work',
    notes:
      'Brief future-facing slot for connected work that may be useful to present: ORCA, NEXUS, EHR-as-language, cross-system translation, and how these might inform later proposals without distracting from the funded CPRD lane.',
  },
  {
    time: '15:40–15:50',
    title: 'Group and collaborator items',
    notes:
      'Practical collaboration items, including whether to add Ewan Pearson to the group or discussion, who should action this, and how it should be framed.',
  },
  {
    time: '15:50–16:00',
    title: 'Close: decisions, owners, and Friday morning shape',
    notes:
      'Confirm decisions, action owners, unresolved questions, and what should be tackled on Friday morning.',
  },
];

const fridayAgenda = [
  {
    time: '09:30–09:45',
    title: 'Re-cap from Thursday',
    notes: 'Confirm decisions, open questions, and any overnight reflections.',
  },
  {
    time: '09:45–10:45',
    title: 'Flexible deep-dive slot 1',
    notes:
      'Candidate uses: CPRD protocol unresolved points, NIHR grant framing, rare-phenotype / fingerprinting methods, onboarding questions, or ORCA/NEXUS future-work implications. Final choice can be made during Thursday close.',
  },
  {
    time: '10:45–11:30',
    title: 'Flexible deep-dive slot 2',
    notes:
      'Continue the most useful thread from slot 1 or split into practical planning: owners, actions, timeline, and pre-reads.',
  },
  {
    time: '11:30–11:50',
    title: 'Action plan and ownership',
    notes: 'Convert the discussion into named actions, deadlines, documents to update, and next meeting or check-in.',
  },
  {
    time: '11:50–12:00',
    title: 'Close',
    notes: 'Confirm what will be circulated after the kick-off and by whom.',
  },
];

const prompts = [
  {
    title: 'NIHR grant',
    points: [
      'What is the strongest fundable question?',
      'Is TRANsCEnD the right vehicle, or is this a linked proposal?',
      'What would make the grant distinctive rather than a generic CPRD analysis proposal?',
      'Who are the minimum necessary partners?',
      'What is the first concrete drafting step?',
    ],
  },
  {
    title: 'Rare phenotype identification / fingerprinting',
    points: [
      'What phenotype or patient group is the first credible target?',
      'What constitutes a “fingerprint” in this setting: code pattern, sequence representation, embedding neighbourhood, model-derived feature, or clinician-interpretable signature?',
      'What validation would make the result believable?',
      'Is this an immediate TRANsCEnD work package, a follow-on analysis, or a separate proposal?',
    ],
  },
  {
    title: 'Future connected work: ORCA / NEXUS',
    points: [
      'Which pieces are mature enough to present as future-facing but credible?',
      'Which are useful scientific context but should not distract from the funded CPRD protocol?',
      'Could ORCA or NEXUS supply methods, infrastructure, or a future proposal route for TRANsCEnD?',
    ],
  },
  {
    title: 'Group and collaboration items',
    points: [
      'Should Ewan Pearson be added to the group or discussion?',
      'Who should invite or add him, and with what framing?',
      'Are there other missing collaborators for the NIHR or fingerprinting route?',
    ],
  },
];
---

<Layout
  title="TRANsCEnD-CPRD agenda — sainsbury.ai"
  description="Draft agenda for the TRANsCEnD-CPRD Glasgow kick-off: project overview, CPRD protocol discussion, NIHR grant, rare phenotype fingerprinting, and future connected work."
  currentPath="/agenda"
  hideNavigation={true}
>
  <section class="agenda-hero panel">
    <div>
      <div class="eyebrow"><span class="dot"></span>Draft meeting agenda</div>
      <h1>TRANsCEnD-CPRD Glasgow kick-off</h1>
      <p class="lead">
        A two-part agenda for a Thursday project kick-off and a flexible Friday morning follow-up,
        designed to align the team around the current CPRD work and the next generation of connected projects.
      </p>
    </div>
    <aside class="agenda-summary" aria-label="Agenda summary">
      <div><span>Thursday</span><strong>09:30–16:00</strong></div>
      <div><span>Coffee</span><strong>11:30</strong></div>
      <div><span>Lunch</span><strong>13:00–13:45</strong></div>
      <div><span>Friday</span><strong>09:30–12:00</strong></div>
    </aside>
  </section>

  <section class="section panel agenda-section" aria-labelledby="thursday-heading">
    <div class="section-head">
      <div>
        <div class="eyebrow">Thursday</div>
        <h2 id="thursday-heading">Project overview, CPRD protocol, and where-next discussion</h2>
      </div>
      <span class="status">09:30–16:00</span>
    </div>

    <div class="agenda-table" role="table" aria-label="Thursday agenda">
      {thursdayAgenda.map((item) => (
        <article class:list={["agenda-row", item.break && "agenda-row--break"]} role="row">
          <div class="agenda-time" role="cell">{item.time}</div>
          <div class="agenda-detail" role="cell">
            <h3>{item.title}</h3>
            <p>{item.notes}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section panel agenda-section" aria-labelledby="friday-heading">
    <div class="section-head">
      <div>
        <div class="eyebrow">Friday morning</div>
        <h2 id="friday-heading">Flexible follow-up session</h2>
      </div>
      <span class="status">09:30–12:00</span>
    </div>
    <p class="muted">
      The Friday morning agenda is deliberately left flexible so the group can decide, during Thursday's close,
      which thread most needs deeper discussion.
    </p>

    <div class="agenda-table agenda-table--compact" role="table" aria-label="Friday morning agenda">
      {fridayAgenda.map((item) => (
        <article class="agenda-row" role="row">
          <div class="agenda-time" role="cell">{item.time}</div>
          <div class="agenda-detail" role="cell">
            <h3>{item.title}</h3>
            <p>{item.notes}</p>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="section panel" aria-labelledby="where-next-heading">
    <div class="section-head">
      <div>
        <div class="eyebrow">Discussion prompts</div>
        <h2 id="where-next-heading">Where next?</h2>
      </div>
    </div>
    <div class="grid two prompt-grid">
      {prompts.map((prompt) => (
        <article class="card panel prompt-card">
          <h3>{prompt.title}</h3>
          <ul>
            {prompt.points.map((point) => <li>{point}</li>)}
          </ul>
        </article>
      ))}
    </div>
  </section>

  <section class="section panel">
    <div class="eyebrow">Expected outputs</div>
    <h2>What the meeting should leave behind</h2>
    <div class="tag-list output-tags">
      <span class="tag">CPRD protocol clarification points</span>
      <span class="tag">Named first work block</span>
      <span class="tag">NIHR grant decision route</span>
      <span class="tag">Fingerprinting next step</span>
      <span class="tag">ORCA / NEXUS follow-on framing</span>
      <span class="tag">Collaborator actions</span>
    </div>
  </section>
</Layout>

<style>
  .agenda-hero {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(260px, 0.7fr);
    gap: 28px;
    padding: 32px;
    margin-bottom: 24px;
    align-items: stretch;
  }

  .agenda-hero h1 {
    margin-top: 0.35rem;
    margin-bottom: 0.7rem;
  }

  .agenda-summary {
    display: grid;
    gap: 10px;
    align-content: center;
  }

  .agenda-summary div {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 14px 16px;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    background: var(--surface-2);
  }

  .agenda-summary span {
    color: var(--muted);
  }

  .agenda-summary strong {
    font-variant-numeric: tabular-nums;
    white-space: nowrap;
  }

  .agenda-section h2 {
    max-width: 55rem;
  }

  .agenda-table {
    display: grid;
    margin-top: 1.2rem;
    border-top: 1px solid var(--line);
  }

  .agenda-row {
    display: grid;
    grid-template-columns: 150px minmax(0, 1fr);
    gap: 22px;
    padding: 18px 0;
    border-bottom: 1px solid var(--line-soft);
  }

  .agenda-row:last-child {
    border-bottom: 0;
  }

  .agenda-row--break {
    background: linear-gradient(90deg, var(--accent-soft), transparent 65%);
    margin: 0 -14px;
    padding: 14px;
    border-radius: var(--radius-sm);
    border-bottom: 1px solid transparent;
  }

  .agenda-time {
    color: var(--accent-ink);
    font-family: var(--font-mono);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
    padding-top: 0.25rem;
  }

  .agenda-detail h3 {
    color: var(--ink);
    font-size: 1.08rem;
    margin: 0 0 0.35rem;
  }

  .agenda-detail p {
    margin: 0;
    color: var(--ink-2);
  }

  .agenda-table--compact .agenda-row {
    padding: 15px 0;
  }

  .prompt-grid {
    margin-top: 1.2rem;
  }

  .prompt-card h3 {
    margin-top: 0;
  }

  .prompt-card ul {
    margin-bottom: 0;
  }

  .output-tags {
    margin-top: 1.1rem;
  }

  @media (max-width: 820px) {
    .agenda-hero {
      grid-template-columns: 1fr;
      padding: 24px;
    }

    .agenda-row {
      grid-template-columns: 1fr;
      gap: 6px;
    }

    .agenda-time {
      padding-top: 0;
    }
  }
</style>

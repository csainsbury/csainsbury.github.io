---
import Layout from '../layouts/Layout.astro';
import publicationsData from '../data/publications.json';
import portfolio from '../data/portfolio.json';
import ProjectCard from '../components/ProjectCard.astro';

const featuredProjects = portfolio.sections.flatMap((section) => section.projects).filter((project) => project.featured);
const milestones = [...portfolio.milestones].sort((a, b) => b.date.localeCompare(a.date)).slice(0, 5);
const dateLabel = (date: string) => new Intl.DateTimeFormat('en-GB', {
  day: 'numeric', month: 'short', year: 'numeric', timeZone: 'UTC',
}).format(new Date(`${date}T00:00:00Z`));
const recentOutputs = publicationsData.items.slice(0, 3);

const themes = [
  'Clinical foundation models',
  'EHR representation learning',
  'Mechanistic interpretability',
  'Translational AI in medicine',
  'Scientific discovery systems',
  'Research software and agent workflows',
];
---

<Layout currentPath="/">
  <section class="hero">
    <div class="panel hero-copy">
      <div class="eyebrow"><span class="dot"></span>Clinical AI · EHR representation · research software</div>
      <h1 class="hero-title">Chris Sainsbury</h1>
      <p class="lead">
        Clinician-researcher working on clinical foundation models, EHR representation learning,
        translational AI, and research software.
      </p>
      <p>
        I work across medicine, machine learning, and research infrastructure. This site is a public
        front page for the main things I am working on: active projects, recent outputs, papers,
        software, and current directions.
      </p>

      <div class="button-row">
        <a class="button primary" href="/projects">View projects</a>
        <a class="button" href="/outputs">Recent outputs</a>
      </div>
    </div>

    <aside class="panel hero-side stack">
      <div class="metric">
        <strong>Public links</strong>
        <div class="tag-list">
          <a class="tag" href="https://glucose.ai" target="_blank" rel="noreferrer">glucose.ai</a>
          <a class="tag" href="https://orcid.org/0000-0002-7984-5721" target="_blank" rel="noreferrer">ORCID</a>
          <a class="tag" href="https://github.com/csainsbury/" target="_blank" rel="noreferrer">GitHub</a>
        </div>
      </div>
      <section class="metric" aria-labelledby="now-heading">
        <div class="eyebrow">Now</div>
        <h2 id="now-heading">Currently working on</h2>
        <p>{portfolio.now.text}</p>
        {portfolio.now.updated && <p class="small muted">Updated <time datetime={portfolio.now.updated}>{dateLabel(portfolio.now.updated)}</time></p>}
      </section>
    </aside>
  </section>

  <section class="section" aria-labelledby="featured-heading">
    <div class="section-head">
      <div>
        <div class="eyebrow">Selected work</div>
        <h2 id="featured-heading">Featured projects</h2>
        <p>The questions behind the work, with milestones linked to public outputs.</p>
      </div>
      <a href="/projects">All projects →</a>
    </div>
    <div class="grid two">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  {milestones.length > 0 && (
    <section class="section panel" aria-labelledby="developments-heading">
      <div class="eyebrow">Papers · software · public outputs</div>
      <h2 id="developments-heading">Public milestones</h2>
      <p class="muted">Selected developments, dated when the work became public. Preprints are work in progress, not peer-reviewed findings.</p>
      <div class="list">
        {milestones.map((milestone) => (
          <article class="list-item">
            <div class="small muted"><time datetime={milestone.date}>{dateLabel(milestone.date)}</time> · {milestone.kind}</div>
            <h3><a href={milestone.href}>{milestone.title}</a></h3>
            <p>{milestone.summary}</p>
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="grid two" style="margin-top: 1rem;">
    <div class="section panel">
      <div class="eyebrow">recent outputs</div>
      <h2>Papers and scholarly outputs</h2>
      <div class="list publications-list">
        {recentOutputs.map((paper) => (
          <article class="list-item publication-item">
            <div class="publication-meta">
              <span class="status">{paper.year}</span>
              {paper.citedBy && <span class="small">Cited by {paper.citedBy}</span>}
            </div>
            <h3>{paper.title}</h3>
            <p class="muted">{paper.authors}</p>
            <p>{paper.venue}</p>
          </article>
        ))}
      </div>
      <p><a href="/outputs">See all outputs</a></p>
    </div>

    <div class="section panel">
      <div class="eyebrow">areas of work</div>
      <h2>What connects the portfolio</h2>
      <p class="copy">
        The portfolio spans academic papers, translational grants, scientific-discovery systems, and
        software for organising research. The aim is not just to build models, but to make them
        clinically meaningful and operationally usable.
      </p>
      <div class="tag-list">
        {themes.map((theme) => (
          <span class="tag">{theme}</span>
        ))}
      </div>
    </div>
  </section>
</Layout>

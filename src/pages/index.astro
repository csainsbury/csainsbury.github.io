---
import Layout from '../layouts/Layout.astro';
import publicationsData from '../data/publications.json';
import portfolio from '../data/portfolio.json';
import ProjectCard from '../components/ProjectCard.astro';

const currentProjects = portfolio.sections.flatMap((section) => section.projects).filter((project) => project.featured);
const recentOutputs = publicationsData.items.slice(0, 4);

// Illustrative record: coded events with day offsets; gaps are drawn to scale.
const events: [string, number, 'event' | 'measure'][] = [
  ['E11 T2DM', 0, 'event'], ['HbA1c 64', 3, 'measure'], ['metformin 500 mg', 14, 'event'],
  ['HbA1c 55', 98, 'measure'], ['eGFR 71', 180, 'measure'], ['metformin 1 g', 196, 'event'],
  ['HbA1c 51', 290, 'measure'], ['SGLT2i', 410, 'event'], ['HbA1c 48', 505, 'measure'],
];
let seed = 23;
const rnd = () => { seed = (seed * 16807) % 2147483647; return seed / 2147483647; };
const tokens = events.map(([code, day, kind], i) => {
  const next = i + 1 < events.length ? events[i + 1][1] - day : 60;
  const vec = [0, 1].map(() => Array.from({ length: 8 }, () => (0.15 + Math.pow(rnd(), 1.6) * 0.85).toFixed(2)));
  return { code, kind, vec, dt: i ? `+${day - events[i - 1][1]}d` : 'day 0', flex: `${Math.max(next, 60)} 0 0` };
});
---

<Layout currentPath="/">
  <section class="hero">
    <h1>Chris<br />Sainsbury</h1>
    <div class="hero__side">
      <p class="hero__lead">Consultant physician in diabetes and endocrinology. I build models that read the health record as a sequence, and study what they learn.</p>
      <p class="hero__posts">
        QEUH · NHS Greater Glasgow and Clyde<br />
        Hon. Clinical Senior Lecturer, University of Glasgow<br />
        Hon. Clinical Reader, University of Dundee<br />
        Hon. Senior Research Fellow, University of Birmingham<br />
        BSc MD FRCP FBCS
      </p>
    </div>
  </section>

  <figure class="record">
    <div class="record__scroll">
      <div class="record__grid" aria-hidden="true">
        <div class="record__row">
          {tokens.map((t) => (
            <div class="record__vec" style={`flex: ${t.flex}`}>
              {t.vec.map((col) => (
                <div class="record__col">
                  {col.map((v) => <div class={`record__dot kind-${t.kind}`} style={`opacity: ${v}`}></div>)}
                </div>
              ))}
            </div>
          ))}
        </div>
        <div class="record__row record__row--tokens">
          {tokens.map((t) => (
            <div class="record__token" style={`flex: ${t.flex}`}>
              <span class={`record__code kind-${t.kind}`}>{t.code}</span>
              <span class="record__dt">{t.dt}</span>
            </div>
          ))}
        </div>
      </div>
    </div>
    <figcaption>
      <span>Illustrative record: coded events in time, gaps drawn to scale. Above each token, its learned representation.</span>
      <span><i class="key-dot kind-event"></i>diagnosis / prescription &nbsp; <i class="key-dot kind-measure"></i>measurement</span>
    </figcaption>
  </figure>

  <section class="section" aria-labelledby="current-heading">
    <h2 id="current-heading" class="label">Current projects</h2>
    <div class="project-grid">
      {currentProjects.map((project) => <ProjectCard project={project} />)}
    </div>
    <a class="textlink" href="/projects">All projects, with aims and approach →</a>
  </section>

  <section class="section" aria-labelledby="outputs-heading">
    <h2 id="outputs-heading" class="label">Recent outputs</h2>
    <div class="outputs">
      {recentOutputs.map((paper) => (
        <div class="output">
          <span class="output__meta">{paper.year} · {paper.venue}</span>
          <div class="output__body">
            {paper.href ? <a class="output__title" href={paper.href} target="_blank" rel="noreferrer">{paper.title}</a> : <span class="output__title">{paper.title}</span>}
          </div>
        </div>
      ))}
    </div>
    <a class="textlink" href="/outputs">All outputs →</a>
  </section>
</Layout>

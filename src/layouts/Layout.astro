---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  currentPath?: string;
  hideNavigation?: boolean;
}

const {
  title = 'Chris Sainsbury — sainsbury.ai',
  description = 'Chris Sainsbury: consultant physician in diabetes and endocrinology in Glasgow, building and studying AI models of electronic health records, clinical decision support and tools for research.',
  currentPath = '/',
  hideNavigation = false,
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site).href;
const person = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Chris Sainsbury',
  url: 'https://sainsbury.ai/',
  email: 'mailto:chris@sainsbury.ai',
  jobTitle: 'Consultant Physician, Diabetes and Endocrinology',
  honorificSuffix: 'BSc MD FRCP FBCS',
  worksFor: { '@type': 'Organization', name: 'NHS Greater Glasgow and Clyde' },
  affiliation: [
    { '@type': 'CollegeOrUniversity', name: 'University of Glasgow' },
    { '@type': 'CollegeOrUniversity', name: 'University of Dundee' },
    { '@type': 'CollegeOrUniversity', name: 'University of Birmingham' },
  ],
  sameAs: [
    'https://orcid.org/0000-0002-7984-5721',
    'https://scholar.google.co.uk/citations?user=6zfnq1kAAAAJ',
    'https://github.com/csainsbury',
  ],
};

const nav = [
  { href: '/projects', label: 'Projects' },
  { href: '/outputs', label: 'Outputs' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="color-scheme" content="light dark" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Geist:wght@300;400;500;600&family=Geist+Mono:wght@400;500&display=swap" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="sainsbury.ai" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <script type="application/ld+json" set:html={JSON.stringify(person)} />
  </head>
  <body>
    <div class="wrap">
      <header class="site-header">
        {hideNavigation ? (
          <span class="brand">sainsbury.ai</span>
        ) : (
          <a href="/" class="brand" aria-label="sainsbury.ai home">sainsbury.ai</a>
        )}
        {!hideNavigation && (
          <nav class="site-nav" aria-label="Main">
            {nav.map((item) => (
              <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>{item.label}</a>
            ))}
            <a href="https://glucose.ai" target="_blank" rel="noreferrer">glucose.ai</a>
            <a href="https://github.com/csainsbury/" target="_blank" rel="noreferrer">GitHub</a>
          </nav>
        )}
      </header>

      <main>
        <slot />
      </main>

      <footer class="site-footer">
        <a class="email" href="mailto:chris@sainsbury.ai">chris@sainsbury.ai</a>
        <a href="https://orcid.org/0000-0002-7984-5721" target="_blank" rel="noreferrer">ORCID</a>
        <a href="https://scholar.google.co.uk/citations?user=6zfnq1kAAAAJ" target="_blank" rel="noreferrer">Google Scholar</a>
        <a href="https://github.com/csainsbury/" target="_blank" rel="noreferrer">GitHub</a>
        <span class="spacer"></span>
        <span>© 2026 Chris Sainsbury</span>
      </footer>
    </div>
  </body>
</html>
